{
  "name": "@thinkthinksyn/nextjs-component",
  "version": "0.0.10",
  "description": "Common Next.js components for sharing across repositories",
  "keywords": [
    "nextjs",
    "react",
    "utils",
    "hooks",
    "typescript"
  ],
  "homepage": "https://github.com/ThinkThinkSyn/tts-nextjs-common-component#readme",
  "bugs": {
    "url": "https://github.com/ThinkThinkSyn/tts-nextjs-common-component/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThinkThinkSyn/tts-nextjs-common-component.git"
  },
  "license": "MIT",
  "author": "Harry",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "esbuild.config.ts",
    "generate-exports.js",
    "postinstall.js",
    "tsconfig.build.json",
    "tsconfig.json",
    "README.md"
  ],
  "scripts": {
    "prepare": "node -e \"if (process.env.NODE_ENV !== 'production') require('child_process').execSync('ts-patch install -s', {stdio: 'inherit'})\"",
    "postinstall": "node postinstall.js",
    "build": "npm run clean && node generate-exports.js && tsx esbuild.config.ts && tsc --project tsconfig.build.json",
    "dev": "tsx esbuild.config.js --watch",
    "test": "next dev",
    "clean": "rimraf dist",
    "pub": "npm publish --access public",
    "unpub-old": "node unpublish-old.js",
    "generate-exports": "node generate-exports.js"
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "esbuild": "^0.25.11",
    "knip": "^5.66.4",
    "postcss": "^8.5.6",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4",
    "ts-patch": "^3.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-transform-paths": "^3.5.5"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-resources-to-backend": "^1.2.1",
    "idb-keyval": "^6.2.2",
    "immer": "^10.2.0",
    "lucide-react": "^0.548.0",
    "next": "^15",
    "react": "^18",
    "react-dom": "^18",
    "react-i18next": "^16.2.3",
    "sse.js": "^2.7.2",
    "zustand": "^5.0.8"
  }
}
